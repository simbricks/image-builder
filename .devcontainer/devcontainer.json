{
  "name": "SimBricks image harness",
  "build": { "dockerfile": "Dockerfile" },

  // Pass the host's KVM device through for hardware-accelerated builds.
  // If your host has no /dev/kvm, remove this line and build with
  // `-var accelerator=tcg` (packer) / `make image ACCELERATOR=tcg`.
  "runArgs": ["--device=/dev/kvm"],

  // A pass-through device keeps the host's group ownership, so the container
  // user can't access it by default; make it usable on each start.
  "postStartCommand": "sudo chmod a+rw /dev/kvm 2>/dev/null || true",

  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.hcl",
        "timonwong.shellcheck"
      ]
    }
  }
}
